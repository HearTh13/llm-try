# Salin file ini menjadi ".env" (tanpa .example) lalu isi nilainya.
# Dipakai saat menjalankan TANPA Docker (dimuat otomatis oleh aplikasi).

# Koneksi database lokal. Sesuaikan PASSWORD dengan password user 'postgres' Anda.
# (Jika password Anda 'root', baris ini boleh dihapus karena sudah jadi default.)
DATABASE_URL=postgresql://postgres:PASSWORD_ANDA@localhost:5432/llm_chat_db

# Kunci Gemini (default provider). Ambil di https://aistudio.google.com/apikey
GEMINI_API_KEY=ISI_API_KEY_GEMINI_ANDA

# Kunci rahasia untuk token login (boleh diisi bebas)
JWT_SECRET=ubah-jadi-kalimat-rahasia-anda

# --- Opsional: pindah ke Ollama lokal (tanpa internet) ---
# LLM_PROVIDER=ollama
# EMBEDDING_PROVIDER=ollama
# LLM_MODEL=qwen3:8b
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_DIM=768
# OLLAMA_BASE_URL=http://localhost:11434
